# ===== DeepSeek 大模型 =====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# ===== LLM 调用超时（秒）=====
LLM_TIMEOUT=30
LLM_STREAM_TIMEOUT=60

# LLM 单价（人民币 / 百万 token），仅用于 /metrics 的
# 成本估算，请按 DEEPSEEK_MODEL 的实际单价修改。
LLM_PRICE_PER_MILLION_INPUT=2.0
LLM_PRICE_PER_MILLION_OUTPUT=8.0

# ===== 历史上下文 =====
CHAT_HISTORY_LIMIT=5
CHAT_HISTORY_MAX_CHARS=12000

# ===== Agent =====
AGENT_MAX_STEPS=5
AGENT_TOOL_RESULT_MAX_CHARS=6000

# ===== 检索 / RAG =====
RAG_MAX_DISTANCE=19.0
# Cross-Encoder 重排阈值；50 兼顾召回与相关性
RAG_RERANK_MIN_SCORE=50
# 额外改写 query 数；明确问题会被门控自动跳过，0=完全关闭。
# 对比 / 指代 / 宽泛问题会自动提升到 2，用于拆分对象、扩展召回
RAG_QUERY_REWRITE_COUNT=1
# Hybrid Search：向量 + 关键词 RRF 融合。
# RRF_K 控制排名衰减（默认 60）；RRF_KEYWORD_WEIGHT 为
# 关键词检索的权重倍数（默认 5.0，提升精确术语命中）
RRF_K=60
RRF_KEYWORD_WEIGHT=5.0
# 父子分块：子块目标字数、每个父块聚合的子块数
RAG_CHILD_CHUNK_SIZE=200
RAG_CHILDREN_PER_PARENT=4

# 统一检索管线参数（生产与评测共用，避免参数漂移）。
# 全局检索（跨文档）命中改写门控时保证的改写数
RAG_GLOBAL_REWRITE_COUNT=2
# 每路 Retriever（向量/关键词）各召回数
RAG_PER_RETRIEVER_TOP_K=5
# RRF 融合后送进 Rerank 的候选数
RAG_FUSION_TOP_K=6
# Rerank 后最终进上下文的片段数
RAG_FINAL_TOP_K=8

# ===== 数据库 =====
# 默认本地 SQLite；生产可换 PostgreSQL/MySQL 连接串
DATABASE_URL=sqlite:///./ai_app.db

# ===== 缓存（LRU + TTL）=====
# Embedding 向量缓存（避免同一文本重复向量化）
EMBEDDING_CACHE_MAXSIZE=4096
EMBEDDING_CACHE_TTL=3600
# 查询改写缓存
REWRITE_CACHE_MAXSIZE=512
REWRITE_CACHE_TTL=86400

# ===== 服务 / 安全（生产环境）=====
# CORS 允许来源（逗号分隔）
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 留空 = 不启用认证；生产环境请设强随机字符串，前端用 X-API-Key 传入
API_KEY=
# 每个 IP 每分钟对 LLM 接口的最大请求数
RATE_LIMIT_PER_MINUTE=20
